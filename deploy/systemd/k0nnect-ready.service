[Unit]
Description=Configure k0nnect encrypted node network
Wants=network-online.target
After=network-online.target
Before=kubelet.service

[Service]
Type=oneshot
EnvironmentFile=/etc/k0nnect/node.env
ExecStart=/usr/local/bin/k0nnect apply --config /etc/k0nnect/inventory.json --node ${K0NNECT_NODE}
RemainAfterExit=yes
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
