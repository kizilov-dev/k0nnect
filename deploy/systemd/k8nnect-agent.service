[Unit]
Description=Reconcile k8nnect encrypted node network
Requires=k8nnect-ready.service
After=k8nnect-ready.service

[Service]
EnvironmentFile=/etc/k8nnect/node.env
ExecStart=/usr/local/bin/k8nnect agent --config /etc/k8nnect/inventory.json --node ${K8NNECT_NODE}
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
