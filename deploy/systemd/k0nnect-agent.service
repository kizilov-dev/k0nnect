[Unit]
Description=Reconcile k0nnect encrypted node network
Requires=k0nnect-ready.service
After=k0nnect-ready.service

[Service]
EnvironmentFile=/etc/k0nnect/node.env
ExecStart=/usr/local/bin/k0nnect agent --config /etc/k0nnect/inventory.json --node ${K0NNECT_NODE}
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
